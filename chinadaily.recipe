import re
import datetime

from calibre.web.feeds.news import BasicNewsRecipe


def target_date():
    """要制作的那一天的新闻：北京时间「当天」0:00 至抓取时刻。"""
    bj_now = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=8)
    return bj_now.date()


class ChinaDaily(BasicNewsRecipe):
    title = 'China Daily'
    __author__ = 'Calibre News Delivery (custom)'
    description = 'China Daily 每日精选：要闻 / China / World / Business / Opinion / Culture'
    language = 'en'
    encoding = 'utf-8'
    no_stylesheets = True
    no_images = True
    remove_javascript = True
    use_embedded_content = False
    max_articles_per_feed = 40
    simultaneous_downloads = 5
    keep_only_tags = [dict(id='Content')]
    remove_tags = [
        dict(name='div', attrs={'class': re.compile('TopHead|Art_Topic|Share|keyword')}),
        dict(name='div', attrs={'id': re.compile('Footer|nav')}),
        dict(name='script'),
        dict(name='style'),
    ]

    # 文章 URL 形如 /a/202611/10/WS6af2....html，日期就在 URL 里
    ART_RE = re.compile(
        r'^(https?://www\.chinadaily\.com\.cn/a/(\d{6})/(\d{2})/WS\w+\.html)$'
    )

    SECTIONS = [
        ('Top News', 'https://www.chinadaily.com.cn/'),
        ('China', 'https://www.chinadaily.com.cn/china'),
        ('World', 'https://www.chinadaily.com.cn/world'),
        ('Business', 'https://www.chinadaily.com.cn/business'),
        ('Opinion', 'https://www.chinadaily.com.cn/opinion'),
        ('Culture', 'https://www.chinadaily.com.cn/culture'),
    ]

    def _article_date(self, url):
        m = self.ART_RE.match(url)
        if not m:
            return None
        yyyymm, dd = m.group(2), m.group(3)
        try:
            return datetime.date(int(yyyymm[:4]), int(yyyymm[4:6]), int(dd))
        except ValueError:
            return None

    def parse_index(self):
        target = target_date()
        self.log(f'Target date (Beijing today): {target}')

        # 1) 收集候选（丢弃比目标日期更旧的，保证绝不混入前天的旧闻）
        buckets, seen = [], set()
        for sec_title, sec_url in self.SECTIONS:
            try:
                soup = self.index_to_soup(sec_url)
            except Exception as e:
                self.log(f'Section failed: {sec_url} ({e})')
                continue
            items = []
            for a in soup.findAll('a', href=True):
                href = a['href'].strip()
                if href.startswith('//'):
                    href = 'https:' + href
                if not self.ART_RE.match(href) or href in seen:
                    continue
                t = (a.get('title') or self.tag_to_string(a)).strip()
                if len(t) < 8:
                    continue
                d = self._article_date(href)
                if d is None or d < target:
                    continue
                seen.add(href)
                items.append((href, t, d))
            if items:
                buckets.append((sec_title, items))

        # 2) 严格取目标日期；若一篇都没有才回退到「昨天及更新」
        for exact in (True, False):
            feeds = []
            for sec_title, items in buckets:
                arts = [
                    {'title': t, 'url': u, 'description': '', 'date': ''}
                    for u, t, d in items
                    if (d == target) or not exact
                ]
                tag = '' if exact else ' (fallback)'
                self.log(f'{sec_title}: {len(arts)}/{len(items)} articles on {target}{tag}')
                if arts:
                    feeds.append((sec_title, arts[: self.max_articles_per_feed]))
            if feeds:
                if not exact:
                    self.log(f'FALLBACK: nothing published on {target}, using latest available')
                return feeds
        raise Exception(f'No articles published on or after {target}')

    def postprocess_html(self, soup, first_fetch):
        for tag in soup.find_all(['img', 'picture', 'source', 'video', 'iframe']):
            tag.decompose()
        return soup
