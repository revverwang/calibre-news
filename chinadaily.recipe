import re
import datetime

from calibre.web.feeds.news import BasicNewsRecipe

CLEAN_CSS = u"""html, body { margin: 0; padding: 0; }
body {
  font-family: "Charter", "Iowan Old Style", "Palatino", Georgia, serif;
  color: #111;
  line-height: 1.62;
  text-align: justify;
  margin: 0.9em 1em 1.6em;
  word-wrap: break-word;
}
h1, h2, h3, h4, h5 {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  text-align: left; line-height: 1.35; page-break-after: avoid;
}
h1 { font-size: 1.46em; font-weight: bold; margin: 0 0 0.85em; padding-bottom: 0.45em; border-bottom: 2px solid #333; }
h2 { font-size: 1.16em; font-weight: bold; margin: 1.9em 0 0.7em; padding-left: 0.55em; border-left: 4px solid #777; }
h3 { font-size: 1.05em; font-weight: bold; margin: 1.6em 0 0.55em; }
p { margin: 0 0 0.85em; text-indent: 0; orphans: 2; widows: 2; }
blockquote { margin: 1.1em 1.4em; padding: 0.2em 0 0.2em 0.9em; border-left: 3px solid #bbb; color: #333; font-style: italic; }
ul, ol { margin: 0.7em 0 0.9em 1.3em; padding: 0; }
li { margin: 0 0 0.35em; }
table { width: 100%; border-collapse: collapse; margin: 1em 0; font-size: 0.92em; }
th, td { border: 1px solid #bbb; padding: 0.4em 0.5em; text-align: left; vertical-align: top; }
th { background: #f2f2f2; font-weight: bold; }
a { color: inherit; text-decoration: none; }
hr { border: 0; border-top: 1px solid #ccc; margin: 1.6em 0; }
sup { font-size: 0.72em; }
img, figure, figcaption, picture, video, iframe, object, embed { display: none !important; }
.calibre_navbar, .calibre_footer { display: none !important; }"""

# ---------------------------------------------------------------------------
# 纯文字 + 工整排版：三个源共用同一套净化规则
# ---------------------------------------------------------------------------
_JUNK_TOKENS = {
    'ad', 'ads', 'adv', 'advert', 'adverts', 'advertisement', 'advertising',
    'promo', 'promotion', 'sponsor', 'sponsored', 'affiliate',
    'share', 'sharing', 'social', 'related', 'recommend', 'recommended',
    'newsletter', 'subscribe', 'subscription', 'paywall',
    'comment', 'comments', 'toolbar', 'breadcrumb', 'navbar', 'footer',
    'sidebar', 'popup', 'modal', 'cookie', 'banner', 'further', 'reading',
}
_MEDIA_TAGS = [
    'img', 'picture', 'source', 'video', 'audio', 'iframe', 'embed', 'object',
    'svg', 'canvas', 'figure', 'figcaption', 'track',
]
_CHROME_TAGS = [
    'script', 'style', 'noscript', 'form', 'button', 'input', 'select',
    'textarea', 'label', 'nav', 'aside',
]
# 图注/署名：以（某某摄）、（图）、“某某 摄”结尾的短块
_CAPTION_END = re.compile(r'[（(][^（）()]{0,16}(摄|图|摄影|供图|资料图)[）)]\s*$')
_CAPTION_TAIL = re.compile(r'[\s　](摄|图)\s*$')
_CREDIT_HEAD = re.compile(
    r'^\s*(图|图片|摄影|摄|图片来源|资料来源|Photo|Photograph|Image|Picture'
    r'|Credit|Source|Illustration|File photo)\s*[:：/]', re.I)
_BYLINE_TAIL = re.compile(
    r'^\s*(责编|编辑|责任编辑|校对|审校|来源|本文来源|文章来源)\s*[:：]')


def _tokens(tag):
    vals = list(tag.get('class') or []) + [tag.get('id') or '']
    out = []
    for v in vals:
        out.extend([t for t in re.split(r'[-_\s]+', str(v).lower()) if t])
    return out


def tidy_article(recipe, soup):
    """剔除图片/广告/推荐位，清掉内联样式，只留干净的文章正文。"""
    from bs4 import BeautifulSoup

    # 0) 部分站点（如环球网）把正文作为转义 HTML 塞进 <textarea>，不还原就会显示成标签文本
    for ta in soup.find_all('textarea'):
        raw = ta.get_text() or ''
        if '<' in raw:
            frag = BeautifulSoup(raw, 'html.parser')
            box = soup.new_tag('div')
            for child in list(frag.contents):
                box.append(child.extract())
            ta.replace_with(box)
        else:
            ta.decompose()

    # 1) 广告/分享/推荐/导航等容器整块删除
    for tag in soup.find_all(True):
        if tag.name in ('html', 'body'):
            continue
        toks = _tokens(tag)
        if toks and any(t in _JUNK_TOKENS for t in toks):
            tag.decompose()
    # 自定义元素（astro-island / adv-loader / zb-web2-poll 之类）
    for tag in soup.find_all(lambda t: t.name and '-' in t.name):
        tag.decompose()

    # 2) 媒体与表单元素
    for name in _MEDIA_TAGS + _CHROME_TAGS:
        for tag in soup.find_all(name):
            tag.decompose()

    # 3) 图注、版权署名、编辑署名等零碎短段
    for tag in soup.find_all(['p', 'div', 'span', 'em', 'strong', 'small']):
        txt = tag.get_text(' ', strip=True)
        if not txt or len(txt) > 130:
            continue
        if (_CREDIT_HEAD.search(txt) or _BYLINE_TAIL.search(txt)
                or _CAPTION_END.search(txt) or _CAPTION_TAIL.search(txt)):
            tag.decompose()

    # 4) 只剩空壳的容器
    for _ in range(3):
        for tag in soup.find_all(['p', 'div', 'span', 'section', 'article',
                                  'em', 'strong', 'b', 'i', 'li', 'h1', 'h2', 'h3', 'h4']):
            if not tag.get_text(strip=True) and not tag.find('br'):
                tag.decompose()

    # 5) 内联样式/宽度/颜色等一律清掉，交给统一 CSS 接管
    for tag in soup.find_all(True):
        for attr in list(tag.attrs):
            if (attr in ('style', 'class', 'id', 'width', 'height', 'align', 'valign',
                         'bgcolor', 'color', 'face', 'size', 'border', 'cellpadding',
                         'cellspacing', 'target', 'rel', 'role', 'dir', 'lang')
                    or attr.startswith('data-') or attr.startswith('aria-')):
                del tag.attrs[attr]

    # 6) 空白规范化（连续空格、全角空格、空行）
    for node in soup.find_all(string=True):
        s = str(node).replace('\xa0', ' ').replace('　', ' ')
        node.replace_with(re.sub(r'[ \t\r\n]+', ' ', s))

    return soup


def target_date():
    """要制作的那一天的新闻：北京时间「当天」0:00 至抓取时刻。"""
    bj_now = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=8)
    return bj_now.date()


class ChinaDaily(BasicNewsRecipe):
    title = 'China Daily'
    __author__ = 'Calibre News Delivery (custom)'
    description = 'China Daily 每日精选：要闻 / China / World / Business / Opinion / Culture'
    language = 'en'
    encoding = 'utf-8'
    no_stylesheets = True
    no_images = True
    extra_css = CLEAN_CSS
    remove_javascript = True
    use_embedded_content = False
    max_articles_per_feed = 40
    simultaneous_downloads = 5
    keep_only_tags = [dict(id='Content')]
    remove_tags = [
        dict(name='div', attrs={'class': re.compile('TopHead|Art_Topic|Share|keyword')}),
        dict(name='div', attrs={'id': re.compile('Footer|nav')}),
        dict(name='script'),
        dict(name='style'),
    ]

    # 文章 URL 形如 /a/202611/10/WS6af2....html，日期就在 URL 里
    ART_RE = re.compile(
        r'^(https?://www\.chinadaily\.com\.cn/a/(\d{6})/(\d{2})/WS\w+\.html)$'
    )

    SECTIONS = [
        ('Top News', 'https://www.chinadaily.com.cn/'),
        ('China', 'https://www.chinadaily.com.cn/china'),
        ('World', 'https://www.chinadaily.com.cn/world'),
        ('Business', 'https://www.chinadaily.com.cn/business'),
        ('Opinion', 'https://www.chinadaily.com.cn/opinion'),
        ('Culture', 'https://www.chinadaily.com.cn/culture'),
    ]

    def _article_date(self, url):
        m = self.ART_RE.match(url)
        if not m:
            return None
        yyyymm, dd = m.group(2), m.group(3)
        try:
            return datetime.date(int(yyyymm[:4]), int(yyyymm[4:6]), int(dd))
        except ValueError:
            return None

    def parse_index(self):
        target = target_date()
        self.log(f'Target date (Beijing today): {target}')

        # 1) 收集候选（丢弃比目标日期更旧的，保证绝不混入前天的旧闻）
        buckets, seen = [], set()
        for sec_title, sec_url in self.SECTIONS:
            try:
                soup = self.index_to_soup(sec_url)
            except Exception as e:
                self.log(f'Section failed: {sec_url} ({e})')
                continue
            items = []
            for a in soup.findAll('a', href=True):
                href = a['href'].strip()
                if href.startswith('//'):
                    href = 'https:' + href
                if not self.ART_RE.match(href) or href in seen:
                    continue
                t = (a.get('title') or self.tag_to_string(a)).strip()
                if len(t) < 8:
                    continue
                d = self._article_date(href)
                if d is None or d < target:
                    continue
                seen.add(href)
                items.append((href, t, d))
            if items:
                buckets.append((sec_title, items))

        # 2) 严格取目标日期；若一篇都没有才回退到「昨天及更新」
        for exact in (True, False):
            feeds = []
            for sec_title, items in buckets:
                arts = [
                    {'title': t, 'url': u, 'description': '', 'date': ''}
                    for u, t, d in items
                    if (d == target) or not exact
                ]
                tag = '' if exact else ' (fallback)'
                self.log(f'{sec_title}: {len(arts)}/{len(items)} articles on {target}{tag}')
                if arts:
                    feeds.append((sec_title, arts[: self.max_articles_per_feed]))
            if feeds:
                if not exact:
                    self.log(f'FALLBACK: nothing published on {target}, using latest available')
                return feeds
        raise Exception(f'No articles published on or after {target}')

    def postprocess_html(self, soup, first_fetch):
        return tidy_article(self, soup)
