p { margin: 0 0 0.55em; text-indent: 2em; orphans: 2; widows: 2; }
blockquote { margin: 1.1em 1.2em; padding: 0.2em 0 0.2em 0.9em; border-left: 3px solid #bbb; color: #333; }
blockquote p { text-indent: 0; }
ul, ol { margin: 0.7em 0 0.9em 1.1em; padding: 0; }
li { margin: 0 0 0.35em; }
table { width: 100%; border-collapse: collapse; margin: 1em 0; font-size: 0.94em; }
