import re
import datetime
import concurrent.futures
import urllib.request

from calibre.web.feeds.news import BasicNewsRecipe

def target_date():
    """要制作的那一天的新闻：北京时间「当天」0:00 至抓取时刻。"""
    bj_now = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=8)
    return bj_now.date()

CLEAN_CSS = u"""html, body { margin: 0; padding: 0; }
body {
  font-family: "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", serif;
  color: #111;
  line-height: 1.78;
  text-align: justify;
  margin: 0.9em 1em 1.6em;
  word-wrap: break-word;
}
h1, h2, h3, h4, h5 {
  font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
  text-align: left; line-height: 1.45; page-break-after: avoid;
}
h1 { font-size: 1.42em; font-weight: bold; margin: 0 0 0.9em; padding-bottom: 0.45em; border-bottom: 2px solid #333; }
h2 { font-size: 1.18em; font-weight: bold; margin: 1.9em 0 0.8em; padding-left: 0.55em; border-left: 4px solid #777; }
