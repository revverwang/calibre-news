import re

from calibre.web.feeds.news import BasicNewsRecipe


class HuanqiuTimes(BasicNewsRecipe):
    title = '环球时报'
    __author__ = 'Calibre News Delivery (custom)'
    description = '环球时报（huanqiu.com）每日精选：首页 / 中国 / 世界 / 军事 / 台海 / 财经'
    language = 'zh_CN'
    encoding = 'utf-8'
    no_stylesheets = True
    remove_javascript = True
    use_embedded_content = False
    max_articles_per_feed = 25
    simultaneous_downloads = 5
    scale_news_images_to_device = True
    keep_only_tags = [dict(attrs={'class': 'article-content'})]
    remove_tags = [
        dict(name='script'),
        dict(name='style'),
    ]

    # 文章链接：https://<频道>.huanqiu.com/article/<id>，ID 不含日期，无法按 URL 过滤新鲜度，
    # 依靠频道首页只展示最新内容 + 每期最多 25 篇控制
    ART_RE = re.compile(r'^(https?://(?:www|china|world|mil|taiwan|finance)\.huanqiu\.com/article/\w+)$')

    SECTIONS = [
        ('首页要闻', 'https://www.huanqiu.com/'),
        ('中国', 'https://china.huanqiu.com'),
        ('世界', 'https://world.huanqiu.com'),
        ('军事', 'https://mil.huanqiu.com'),
        ('台海', 'https://taiwan.huanqiu.com'),
        ('财经', 'https://finance.huanqiu.com'),
    ]

    def parse_index(self):
        feeds, seen = [], set()
        for sec_title, sec_url in self.SECTIONS:
            articles = []
            try:
                soup = self.index_to_soup(sec_url)
            except Exception as e:
                self.log(f'Section failed: {sec_url} ({e})')
                continue
            for a in soup.findAll('a', href=True):
                href = a['href']
                if href.startswith('//'):
                    href = 'https:' + href
                if not self.ART_RE.match(href) or href in seen:
                    continue
                seen.add(href)
                t = (a.get('title') or self.tag_to_string(a)).strip()
                if len(t) < 6:
                    continue
                articles.append(
                    {'title': t, 'url': href, 'description': '', 'date': ''}
                )
            if articles:
                self.log(f'{sec_title}: {len(articles)} articles')
                feeds.append((sec_title, articles[: self.max_articles_per_feed]))
        if not feeds:
            raise EmptyIndex('No fresh articles found')
        return feeds
